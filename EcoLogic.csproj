<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
    -->
    <TargetFramework>net7.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>1.0</Version>
    <Title>EcoLogic</Title>
    <Company>EcoLogic Authors</Company>
    <Description>EcoLogic Grasshopper components</Description>
    <AssemblyName>EcoLogic</AssemblyName>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <PackageReference Include="NumSharp" Version="0.30.0" />
  </ItemGroup>

  <!-- Include icon resources: SVGs embedded and PNGs copied to output when present -->
  <ItemGroup>
    <EmbeddedResource Include="IconResource\**\*.svg" />
    <None Include="IconResource\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
  <!-- Include Python files to be copied to output directory -->
  <ItemGroup>
    <None Include="PythonFiles\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="PythonFiles\**\*.gh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="PythonFiles\**\*.3dm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Post-build event to copy files to DEMO folder -->
  <Target Name="CopyToDemo" AfterTargets="Build">
    <ItemGroup>
      <OutputFiles Include="$(OutputPath)**" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputFiles)" DestinationFiles="@(OutputFiles->'$(ProjectDir)DEMO\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  
  <!-- Reference WinForms for .NET 7.0 on macOS -->
  <ItemGroup>
    <!-- Rhino 8.10 and earlier -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\\.NETFramework\\v4.8\\System.Windows.Forms.dll" Private="False" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
